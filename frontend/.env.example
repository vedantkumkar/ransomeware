# ── Frontend data source configuration ──────────────────────────────────────
# VITE_USE_MOCK_API=true  → use local mock data (default; no backend required)
# VITE_USE_MOCK_API=false → call the FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# FastAPI backend URL (only used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=http://localhost:8000
