# ── Node / frontend ─────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*

# ── Environment files (keep .env.example) ───────
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ── Logs ────────────────────────────────────────
*.log
logs/

# ── Runtime artifacts (regenerated by the demo) ─
backend/ransomguard.db
backend/ransomguard.db-*
backend/evidence_storage/

# ── Simulator / PyInstaller build output ────────
simulator/build/
simulator/dist/
simulator/*.spec

# ── Editor / OS ─────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
